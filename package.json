{
  "name": "monoworld",
  "private": true,
  "version": "0.1.0",
  "description": "A lightweight, original pixel-art multiplayer RPG prototype",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start:server": "tsx server/index.ts"
  },
  "dependencies": {
  "@colyseus/schema": "^3.0.0",
  "@colyseus/sdk": "^0.16.1",
  "colyseus": "^0.16.5",
  "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
